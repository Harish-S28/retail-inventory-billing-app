PORT=4000
JWT_SECRET=replace-this-with-a-long-random-string

# Production only (Render/Railway backend). Leave unset for local dev —
# the app falls back to a local SQLite file automatically.
# Get this connection string from Neon / Supabase / your Postgres provider.
DATABASE_URL=

# Production only. Set this to your deployed Vercel frontend URL so CORS
# only allows requests from your own app, e.g. https://your-app.vercel.app
FRONTEND_URL=

# Optional - wire these into src/routes/ai.js to use a real LLM instead of
# the built-in rule-based assistant.
OPENAI_API_KEY=
GEMINI_API_KEY=

# AI Assistant - xAI Grok API key (get one at console.x.ai). When set, the
# AI Assistant answers using Grok grounded in your live shop data instead of
# the built-in rule-based answers. Leave blank to keep using the built-in
# answers - the app works fine either way.
GROK_API_KEY=
# Optional - which Grok model to use. Defaults to grok-4.3 if left blank.
GROK_MODEL=

# Optional - payment gateway (billing page currently records "cash"/"card"
# as a label only; wire this up in routes/sales.js to actually charge)
STRIPE_SECRET_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional - email/SMS alert delivery
SENDGRID_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
